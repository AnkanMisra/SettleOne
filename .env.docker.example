# SettleOnce — Docker Environment Variables
# ============================================================
# Copy this file to .env.docker and fill in your values.
#   cp .env.docker.example .env.docker
#
# .env.docker is gitignored — never commit real keys.
#
# All variables have safe defaults. The stack will start and
# function for local development with an empty .env.docker.
# ============================================================


# ============================================================
# BACKEND
# ============================================================

# Port the Rust API server listens on inside the container.
# The host port mapping is defined in docker-compose.yml (3001:3001).
PORT=3001

# Log verbosity. Options: error | warn | info | debug | trace
# Module-level: settleonce_backend=debug,tower_http=info
RUST_LOG=settleonce_backend=info,tower_http=info

# Ethereum mainnet RPC — used for config; ENS currently resolves via ensdata.net API
ETH_RPC_URL=https://eth.llamarpc.com

# Arc Chain RPC
ARC_RPC_URL=https://rpc.arc.circle.com

# LI.FI cross-chain quote API
LIFI_API_URL=https://li.quest/v1
# Optional: improves rate limits on LI.FI. Leave blank for free tier.
LIFI_API_KEY=

# Yellow Network API Key (optional)
YELLOW_API_KEY=

# Contract addresses — informational, not enforced by backend
SETTLEMENT_CONTRACT_ADDRESS=
USDC_CONTRACT_ADDRESS=


# ============================================================
# FRONTEND (BUILD-TIME)
#
# NEXT_PUBLIC_* variables are embedded into the JavaScript
# bundle when the image is built. To change them you must
# rebuild the image:  docker compose up --build frontend
# ============================================================

# URL the browser uses to reach the backend API.
# When running both services with docker compose, use the
# container service name "backend" — NOT "localhost":
NEXT_PUBLIC_API_URL=http://backend:3001

# If you are running ONLY the frontend container (not the full
# stack), point to wherever your backend is actually running:
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Alchemy API key for Ethereum mainnet / Sepolia RPC (optional).
# Without this, wagmi falls back to public RPC endpoints.
NEXT_PUBLIC_ALCHEMY_ID=

# WalletConnect project ID — get one at https://cloud.walletconnect.com
# Required if you want WalletConnect modal support.
NEXT_PUBLIC_WALLETCONNECT_ID=

# Arc Testnet RPC URL (optional — has a sensible default)
NEXT_PUBLIC_ARC_RPC=https://rpc.arc.circle.com

# Yellow Network environment.
# Leave blank (or "sandbox") for the testnet ClearNode.
# Set to "production" to connect to the mainnet ClearNode.
NEXT_PUBLIC_YELLOW_ENV=


# ============================================================
# CONTRACTS
# (only needed if you use the contracts service / profile)
# ============================================================

# Deployer wallet private key — required for testnet/mainnet deployments.
# DO NOT use a wallet holding real funds without understanding the risks.
PRIVATE_KEY=

# RPC URLs — all have public defaults, override with paid endpoints for reliability
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Set to "true" to print gas usage after tests
REPORT_GAS=false
