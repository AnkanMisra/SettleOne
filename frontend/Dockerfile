# =============================================================================
# Stage 1: deps
# Install all node_modules with pnpm. This layer is cached until
# package.json or pnpm-lock.yaml change.
# =============================================================================
FROM node:20-alpine AS deps
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app
# Copy workspace config alongside package.json so pnpm respects ignored build
# deps (sharp, unrs-resolver) defined in pnpm-workspace.yaml
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./
RUN pnpm install --frozen-lockfile

# =============================================================================
# Stage 2: builder
# Runs `next build` which produces the standalone output directory.
# NEXT_PUBLIC_* variables are baked into the JS bundle at build time —
# pass them as build args via docker compose or `docker build --build-arg`.
# =============================================================================
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

# Receive all NEXT_PUBLIC_* vars as build args so they are embedded at build time.
# No default for NEXT_PUBLIC_API_URL — forces an explicit value at build time.
# When using docker compose, the value comes from .env.docker or the compose args block.
# When building standalone with `docker build`, pass: --build-arg NEXT_PUBLIC_API_URL=...
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_ALCHEMY_ID=
ARG NEXT_PUBLIC_WALLETCONNECT_ID=
ARG NEXT_PUBLIC_ARC_RPC=https://rpc.arc.circle.com
ARG NEXT_PUBLIC_YELLOW_ENV=

# Expose them as ENV so Next.js picks them up during `next build`
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_ALCHEMY_ID=$NEXT_PUBLIC_ALCHEMY_ID
ENV NEXT_PUBLIC_WALLETCONNECT_ID=$NEXT_PUBLIC_WALLETCONNECT_ID
ENV NEXT_PUBLIC_ARC_RPC=$NEXT_PUBLIC_ARC_RPC
ENV NEXT_PUBLIC_YELLOW_ENV=$NEXT_PUBLIC_YELLOW_ENV

# Disable Next.js telemetry inside Docker
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm build

# =============================================================================
# Stage 3: runner
# Minimal runtime — only the standalone output, public assets, and static files.
# output: "standalone" in next.config.ts makes Next.js produce a self-contained
# server at .next/standalone/server.js with only the needed node_modules copied in.
# Final image is ~120MB vs 1GB+ with a full node_modules.
# =============================================================================
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Create a non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy the standalone build output
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
# Copy static assets (generated by next build)
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
# Copy public directory
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:3000/ || exit 1

# next start in standalone mode uses server.js directly
CMD ["node", "server.js"]
